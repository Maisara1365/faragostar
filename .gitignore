# =========================================================
# FARAGOSTAR PROJECT
# =========================================================

# =========================================================
# FRONTEND - Next.js
# =========================================================

# Dependencies - can be installed with npm install
frontend/node_modules/

# Next.js generated build
frontend/.next/

# Next.js static export
frontend/out/

# Turbopack
frontend/.turbo/

# Vercel generated files
frontend/.vercel/

# Frontend logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# =========================================================
# BACKEND - Laravel
# =========================================================

# PHP dependencies - can be installed with composer install
backend/vendor/

# Laravel generated cache
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*

# Laravel logs
backend/storage/logs/*.log

# PHPUnit cache
backend/.phpunit.result.cache

# =========================================================
# GENERAL
# =========================================================

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak
*.swp